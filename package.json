{
  "name": "@andychukse/nuxt-auth",
  "version": "1.1.2",
  "description": "A Simple Nuxt authentication module with JWT and social login support for Nuxt Apps with separate backend",
  "keywords": [
    "nuxt",
    "nuxt3",
    "authentication",
    "auth",
    "jwt",
    "social-login",
    "google-auth",
    "module"
  ],
  "author": "Andrew Eze",
  "license": "MIT",
  "main": "./dist/module.mjs",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "clean": "rm -rf playground-authjs/.nuxt playground-local/.nuxt playground-refresh/.nuxt dist .nuxt"
  },
  "dependencies": {
    "defu": "^6.1.4",
    "@nuxt/kit": "^4.2.1"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.1.1",
    "@nuxt/eslint-config": "^1.11.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.2.1",
    "@nuxt/test-utils": "^3.21.0",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "eslint": "^9.39.1",
    "nuxt": "^4.2.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andychukse/nuxt-auth.git"
  },
  "bugs": {
    "url": "https://github.com/andychukse/nuxt-auth/issues"
  },
  "homepage": "https://github.com/andychukse/nuxt-auth#readme"
}
